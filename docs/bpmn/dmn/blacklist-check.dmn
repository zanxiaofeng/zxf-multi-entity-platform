<?xml version="1.0" encoding="UTF-8"?>
<!--
  黑名单比对（文档 2.4）。hitPolicy = FIRST + 兜底行。S3b 六张表之一。
  分工边界：名单库比对（查询）由 svcAssembleInput 预置 blacklistHit 变量
  （内部黑名单=本行维护名单库，与 S3a 外部五类名单筛查不同源）；本表只做
  命中类型的处置分流——DMN 是"条件→结论"映射，不做数据查询（系统设计文档 4.3）。
  输出 blacklistPassed 供 exception-trigger 汇聚。
-->
<definitions xmlns="http://www.omg.org/spec/DMN/20150501"
             id="definitions_blacklist_check" name="内部黑名单比对"
             namespace="http://zxf.com/platform/onboarding/dmn">
  <decision id="blacklist-check" name="内部黑名单比对">
    <decisionTable id="blacklistCheckTable" hitPolicy="FIRST">
      <input label="内部黑名单命中类型">
        <inputExpression id="inputExpression_bl" typeRef="string">
          <text>blacklistHit</text>
        </inputExpression>
        <inputValues>
          <text>"NONE","INTERNAL_LISTED","ASSOCIATED"</text>
        </inputValues>
      </input>
      <output id="output_blacklist_passed" label="黑名单校验结论" name="blacklistPassed" typeRef="boolean"/>
      <output id="output_blacklist_action" label="处置动作" name="blacklistAction" typeRef="string">
        <outputValues>
          <text>"REJECT","RESTRICT","NONE"</text>
        </outputValues>
      </output>
      <!-- 列入本行黑名单：按内部政策可能拒绝 -->
      <rule>
        <inputEntry id="ie_bc_1"><text><![CDATA[== "INTERNAL_LISTED"]]></text></inputEntry>
        <outputEntry id="oe_bc_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_bc_2"><text><![CDATA["REJECT"]]></text></outputEntry>
      </rule>
      <!-- 关联方命中（担保人/关联企业列入）：限制产品，转例外审批 -->
      <rule>
        <inputEntry id="ie_bc_2"><text><![CDATA[== "ASSOCIATED"]]></text></inputEntry>
        <outputEntry id="oe_bc_3"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_bc_4"><text><![CDATA["RESTRICT"]]></text></outputEntry>
      </rule>
      <!-- 兜底：未命中 -->
      <rule>
        <inputEntry id="ie_bc_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_bc_5"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_bc_6"><text><![CDATA["NONE"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
