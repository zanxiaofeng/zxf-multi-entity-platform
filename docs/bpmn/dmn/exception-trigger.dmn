<?xml version="1.0" encoding="UTF-8"?>
<!--
  例外审批触发（文档 2.4）。hitPolicy = FIRST + 兜底行。S3b 六张表的**汇聚节点**：
  前五张表（industry/region/limit/product/blacklist）的布尔结论在本表汇聚为
  eligibilityPassed 与 exceptionRequired——任一校验不过即触发例外审批路径，
  由 S4 审批路由按例外标记上收审批层级。
  输出 eligibilityPassed 为主流程 callS3b 的 out 变量（网关/审批输入）。
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_exception_trigger" name="例外审批触发"
             namespace="http://zxf.com/platform/onboarding/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <decision id="exception-trigger" name="例外审批触发">
    <decisionTable id="exceptionTriggerTable" hitPolicy="FIRST">
      <input id="input_1" label="行业校验结论">
        <inputExpression id="inputExpression_ip" typeRef="boolean">
          <text>industryPassed</text>
        </inputExpression>
      </input>
      <input id="input_2" label="区域校验结论">
        <inputExpression id="inputExpression_rp" typeRef="boolean">
          <text>regionPassed</text>
        </inputExpression>
      </input>
      <input id="input_3" label="额度校验结论">
        <inputExpression id="inputExpression_lp" typeRef="boolean">
          <text>limitPassed</text>
        </inputExpression>
      </input>
      <input id="input_4" label="产品适配结论">
        <inputExpression id="inputExpression_pf" typeRef="boolean">
          <text>productFit</text>
        </inputExpression>
      </input>
      <input id="input_5" label="黑名单校验结论">
        <inputExpression id="inputExpression_bp" typeRef="boolean">
          <text>blacklistPassed</text>
        </inputExpression>
      </input>
      <output id="output_eligibility" label="准入校验结论" name="eligibilityPassed" typeRef="boolean"/>
      <output id="output_exception_required" label="是否触发例外审批" name="exceptionRequired" typeRef="boolean"/>
      <output id="output_exception_reason" label="例外原因" name="exceptionReason" typeRef="string"/>
      <rule>
        <inputEntry id="ie_et_1"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="ie_et_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_3"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_4"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_5"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_et_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_2"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_3"><text><![CDATA["行业政策"]]></text></outputEntry>
      </rule>
      <rule>
        <inputEntry id="ie_et_6"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_7"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="ie_et_8"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_9"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_10"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_et_4"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_5"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_6"><text><![CDATA["区域政策"]]></text></outputEntry>
      </rule>
      <rule>
        <inputEntry id="ie_et_11"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_12"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_13"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="ie_et_14"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_15"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_et_7"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_8"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_9"><text><![CDATA["额度适配"]]></text></outputEntry>
      </rule>
      <rule>
        <inputEntry id="ie_et_16"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_17"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_18"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_19"><text><![CDATA[== false]]></text></inputEntry>
        <inputEntry id="ie_et_20"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_et_10"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_11"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_12"><text><![CDATA["产品适配"]]></text></outputEntry>
      </rule>
      <rule>
        <inputEntry id="ie_et_21"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_22"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_23"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_24"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_25"><text><![CDATA[== false]]></text></inputEntry>
        <outputEntry id="oe_et_13"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_14"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_15"><text><![CDATA["内部黑名单"]]></text></outputEntry>
      </rule>
      <!-- 兜底：全部通过 -->
      <rule>
        <inputEntry id="ie_et_26"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_27"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_28"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_29"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_et_30"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_et_16"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_et_17"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_et_18"><text><![CDATA[""]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_exception-trigger" dmnElementRef="exception-trigger">
        <dc:Bounds x="160" y="80" width="180" height="80"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
