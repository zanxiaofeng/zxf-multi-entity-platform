<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_industry_policy" name="行业政策校验"
             namespace="http://zxf.com/platform/onboarding/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <!--
  行业政策校验（文档 2.4）。hitPolicy = FIRST + 兜底行（校验类规则维度可重叠，
  不用 UNIQUE 防漏行）。S3b 六张表之一，由行业政策条线独立维护。
  输入 industryCode 由 svcAssembleInput（S3b 数据装配 delegate）从业务库客户属性
  预置——DMN 只做条件判断，不做数据查询。行业限制清单为示意骨架
  （限制类/产能过剩类/监管叫停类），条线补全。
-->

  <decision id="industry-policy" name="行业政策校验">
    <decisionTable id="industryPolicyTable" hitPolicy="FIRST">
      <input id="input_1" label="行业编码">
        <inputExpression id="inputExpression_ic" typeRef="string">
          <text>industryCode</text>
        </inputExpression>
      </input>
      <input id="input_2" label="客户类型">
        <inputExpression id="inputExpression_ct" typeRef="string">
          <text>customerType</text>
        </inputExpression>
      </input>
      <input id="input_3" label="业务品种">
        <inputExpression id="inputExpression_bt" typeRef="string">
          <text>businessType</text>
        </inputExpression>
      </input>
      <output id="output_industry_passed" label="行业校验结论" name="industryPassed" typeRef="boolean"/>
      <output id="output_industry_note" label="说明" name="industryNote" typeRef="string"/>
      <!-- 示意：限制类行业直接拒绝 -->
      <rule>
        <inputEntry id="ie_ip_1"><text><![CDATA[== "RESTRICTED"]]></text></inputEntry>
        <inputEntry id="ie_ip_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_ip_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_ip_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_ip_2"><text><![CDATA["行业属于限制类清单"]]></text></outputEntry>
      </rule>
      <!-- 示意：授信类业务对高污染高耗能行业从严 -->
      <rule>
        <inputEntry id="ie_ip_4"><text><![CDATA[== "HIGH_ENERGY"]]></text></inputEntry>
        <inputEntry id="ie_ip_5"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_ip_6"><text><![CDATA[== "CREDIT" || == "LOAN"]]></text></inputEntry>
        <outputEntry id="oe_ip_3"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_ip_4"><text><![CDATA["授信业务限制高耗能行业"]]></text></outputEntry>
      </rule>
      <!-- 兜底：通过 -->
      <rule>
        <inputEntry id="ie_ip_7"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_ip_8"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_ip_9"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_ip_5"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_ip_6"><text><![CDATA[""]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_industry-policy" dmnElementRef="industry-policy">
        <dc:Bounds x="160" y="80" width="180" height="80"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
