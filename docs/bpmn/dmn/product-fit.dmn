<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_product_fit" name="产品适配校验"
             namespace="http://zxf.com/platform/onboarding/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <!--
  产品适配校验（文档 2.4）。hitPolicy = FIRST + 兜底行。S3b 六张表之一，
  由产品条线独立维护。输入 productCode 由 svcAssembleInput 预置（业务库产品目录）。
  示意骨架：产品风险等级与客户准入状态/业务品种的适配矩阵。
-->

  <decision id="product-fit" name="产品适配校验">
    <decisionTable id="productFitTable" hitPolicy="FIRST">
      <input id="input_1" label="产品代码">
        <inputExpression id="inputExpression_pc" typeRef="string">
          <text>productCode</text>
        </inputExpression>
      </input>
      <input id="input_2" label="客户类型">
        <inputExpression id="inputExpression_ct" typeRef="string">
          <text>customerType</text>
        </inputExpression>
      </input>
      <input id="input_3" label="业务品种">
        <inputExpression id="inputExpression_bt" typeRef="string">
          <text>businessType</text>
        </inputExpression>
      </input>
      <output id="output_product_fit" label="产品适配结论" name="productFit" typeRef="boolean"/>
      <output id="output_product_note" label="说明" name="productNote" typeRef="string"/>
      <!-- 示意：衍生类产品仅限合格交易主体 -->
      <rule>
        <inputEntry id="ie_pf_1"><text><![CDATA[== "DERIVATIVE"]]></text></inputEntry>
        <inputEntry id="ie_pf_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_pf_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_pf_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_pf_2"><text><![CDATA["衍生类产品需另行准入合格交易主体"]]></text></outputEntry>
      </rule>
      <!-- 示意：理财风险等级与业务品种错配 -->
      <rule>
        <inputEntry id="ie_pf_3b"><text><![CDATA[== "WEALTH_R5"]]></text></inputEntry>
        <inputEntry id="ie_pf_4"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_pf_5"><text><![CDATA[== "WEALTH"]]></text></inputEntry>
        <outputEntry id="oe_pf_3"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_pf_4"><text><![CDATA["R5 理财需另行风险测评"]]></text></outputEntry>
      </rule>
      <!-- 兜底：通过 -->
      <rule>
        <inputEntry id="ie_pf_6"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_pf_7"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_pf_8"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_pf_5"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_pf_6"><text><![CDATA[""]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_product-fit" dmnElementRef="product-fit">
        <dc:Bounds x="160" y="80" width="180" height="80"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
