<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_region_policy" name="区域政策校验"
             namespace="http://zxf.com/platform/onboarding/dmn"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/">
  <!--
  区域政策校验（文档 2.4）。hitPolicy = FIRST + 兜底行。S3b 六张表之一，
  由区域政策条线独立维护。输入 regionCode/isCrossBorder 由 svcAssembleInput 预置。
  示意骨架：制裁涉及地区拒绝、跨境业务高风险地区从严。
-->

  <decision id="region-policy" name="区域政策校验">
    <decisionTable id="regionPolicyTable" hitPolicy="FIRST">
      <input id="input_1" label="区域编码">
        <inputExpression id="inputExpression_rc" typeRef="string">
          <text>regionCode</text>
        </inputExpression>
      </input>
      <input id="input_2" label="是否跨境">
        <inputExpression id="inputExpression_xb" typeRef="boolean">
          <text>isCrossBorder</text>
        </inputExpression>
      </input>
      <input id="input_3" label="业务品种">
        <inputExpression id="inputExpression_bt" typeRef="string">
          <text>businessType</text>
        </inputExpression>
      </input>
      <output id="output_region_passed" label="区域校验结论" name="regionPassed" typeRef="boolean"/>
      <output id="output_region_note" label="说明" name="regionNote" typeRef="string"/>
      <rule>
        <inputEntry id="ie_rp_1"><text><![CDATA[== "SANCTIONED_AREA"]]></text></inputEntry>
        <inputEntry id="ie_rp_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rp_3"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rp_1"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_rp_2"><text><![CDATA["注册地属制裁涉及地区"]]></text></outputEntry>
      </rule>
      <rule>
        <inputEntry id="ie_rp_4"><text><![CDATA[== "HIGH_RISK_AREA"]]></text></inputEntry>
        <inputEntry id="ie_rp_5"><text><![CDATA[== true]]></text></inputEntry>
        <inputEntry id="ie_rp_6"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rp_3"><text><![CDATA[false]]></text></outputEntry>
        <outputEntry id="oe_rp_4"><text><![CDATA["跨境业务限制高风险地区"]]></text></outputEntry>
      </rule>
      <!-- 兜底：通过 -->
      <rule>
        <inputEntry id="ie_rp_7"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rp_8"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rp_9"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rp_5"><text><![CDATA[true]]></text></outputEntry>
        <outputEntry id="oe_rp_6"><text><![CDATA[""]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_region-policy" dmnElementRef="region-policy">
        <dc:Bounds x="160" y="80" width="180" height="80"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
