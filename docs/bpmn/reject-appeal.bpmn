<?xml version="1.0" encoding="UTF-8"?>
<!--
  P1 拒绝与申诉（文档 3.1，含 8.3-A1 申诉闭环）。
  通知纪律：仅普通拒绝通知客户；制裁/PEP 命中不通知（反洗钱保密义务）。
  申诉闭环（A1 修正后机制）：通知后经 Event-Based Gateway 等申诉（申诉窗口 Timer /
  客户申诉 Message 先到先走）；申诉复审次数上限 3 次（达上限强制终止，防无限期挂起）；
  申诉成功**不回退原实例**（主流程已 None End，引擎不支持在已结束实例上回退）——
  由 delegate 发起新准入实例，businessKey 关联 appealOf=原申请编号实现跨实例追溯，
  新实例按行内制度确定重走起点。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <message id="msgCustomerAppeal" name="customer-appeal"/>

    <process id="reject-appeal" name="P1 拒绝与申诉">
        <laneSet>
            <lane id="laneRm" name="客户经理（RM）">
                <flowNodeRef>utRejectRegister</flowNodeRef>
            </lane>
            <lane id="laneCompliance" name="合规/反洗钱岗">
                <flowNodeRef>utAppealReview</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>gwHitType</flowNodeRef>
                <flowNodeRef>sendNotifyCustomer</flowNodeRef>
                <flowNodeRef>ebgwAppeal</flowNodeRef>
                <flowNodeRef>iccAppealWindow</flowNodeRef>
                <flowNodeRef>iccCustomerAppeal</flowNodeRef>
                <flowNodeRef>gwAppealResult</flowNodeRef>
                <flowNodeRef>svcRestartOnboarding</flowNodeRef>
                <flowNodeRef>gwAppealLimit</flowNodeRef>
                <flowNodeRef>endNoNotify</flowNodeRef>
                <flowNodeRef>endWindowClosed</flowNodeRef>
                <flowNodeRef>endRestarted</flowNodeRef>
                <flowNodeRef>endFinal</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start"/>
        <userTask id="utRejectRegister" name="拒绝原因登记（结构化拒绝码 + 说明）"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="rejection-register"/>
        <exclusiveGateway id="gwHitType" name="制裁/PEP 命中？" default="flowToNotify"/>
        <sendTask id="sendNotifyCustomer" name="通知客户（仅普通拒绝）"
                  flowable:delegateExpression="${customerNotifyDelegate}"/>

        <eventBasedGateway id="ebgwAppeal" name="申诉窗口"/>
        <intermediateCatchEvent id="iccAppealWindow" name="申诉窗口到期">
            <timerEventDefinition>
                <timeDuration>${appealWindow}</timeDuration>
            </timerEventDefinition>
        </intermediateCatchEvent>
        <intermediateCatchEvent id="iccCustomerAppeal" name="客户申诉">
            <messageEventDefinition messageRef="msgCustomerAppeal"/>
        </intermediateCatchEvent>

        <userTask id="utAppealReview" name="申诉受理与复审"
                  flowable:candidateGroups="aml-compliance" flowable:formKey="appeal-review"/>
        <exclusiveGateway id="gwAppealResult" name="申诉结果" default="flowToAppealLimit"/>
        <!-- 8.3-A1：新实例 businessKey=appealOf(原申请编号)；重走起点按行内制度 -->
        <serviceTask id="svcRestartOnboarding" name="发起新准入实例（appealOf 关联）"
                     flowable:delegateExpression="${appealRestartDelegate}"/>
        <exclusiveGateway id="gwAppealLimit" name="申诉次数已达上限？" default="flowBackToReview"/>
        <endEvent id="endNoNotify" name="制裁/PEP 命中（不通知客户）"/>
        <endEvent id="endWindowClosed" name="申诉窗口关闭"/>
        <endEvent id="endRestarted" name="已发起新准入实例"/>
        <endEvent id="endFinal" name="申诉终局（达上限）"/>

        <sequenceFlow id="flowStartRegister" sourceRef="start" targetRef="utRejectRegister"/>
        <sequenceFlow id="flowRegisterGw" sourceRef="utRejectRegister" targetRef="gwHitType"/>
        <sequenceFlow id="flowNoNotify" sourceRef="gwHitType" targetRef="endNoNotify">
            <conditionExpression xsi:type="tFormalExpression">${hitFlag == 'SANCTIONS' || hitFlag == 'PEP'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowToNotify" sourceRef="gwHitType" targetRef="sendNotifyCustomer"/>
        <sequenceFlow id="flowNotifyEbgw" sourceRef="sendNotifyCustomer" targetRef="ebgwAppeal"/>
        <sequenceFlow id="flowEbgwWindow" sourceRef="ebgwAppeal" targetRef="iccAppealWindow"/>
        <sequenceFlow id="flowEbgwAppeal" sourceRef="ebgwAppeal" targetRef="iccCustomerAppeal"/>
        <sequenceFlow id="flowWindowEnd" sourceRef="iccAppealWindow" targetRef="endWindowClosed"/>
        <sequenceFlow id="flowAppealReview" sourceRef="iccCustomerAppeal" targetRef="utAppealReview"/>
        <sequenceFlow id="flowReviewGw" sourceRef="utAppealReview" targetRef="gwAppealResult"/>
        <sequenceFlow id="flowAppealSuccess" sourceRef="gwAppealResult" targetRef="svcRestartOnboarding">
            <conditionExpression xsi:type="tFormalExpression">${appealSuccess == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowRestartEnd" sourceRef="svcRestartOnboarding" targetRef="endRestarted"/>
        <sequenceFlow id="flowToAppealLimit" sourceRef="gwAppealResult" targetRef="gwAppealLimit"/>
        <sequenceFlow id="flowLimitFinal" sourceRef="gwAppealLimit" targetRef="endFinal">
            <conditionExpression xsi:type="tFormalExpression">${appealCount &gt;= 3}</conditionExpression>
        </sequenceFlow>
        <!-- 未达上限：回到复审受理下一轮申诉 -->
        <sequenceFlow id="flowBackToReview" sourceRef="gwAppealLimit" targetRef="utAppealReview"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="reject-appeal">
            <bpmndi:BPMNShape id="BPMNShape_laneRm" bpmnElement="laneRm" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="2326" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneCompliance" bpmnElement="laneCompliance" isHorizontal="true">
                <omgdc:Bounds x="180" y="260" width="2326" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="440" width="2326" height="300"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utRejectRegister" bpmnElement="utRejectRegister">
                <omgdc:Bounds x="480" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwHitType" bpmnElement="gwHitType">
                <omgdc:Bounds x="720" y="505" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_sendNotifyCustomer" bpmnElement="sendNotifyCustomer">
                <omgdc:Bounds x="960" y="485" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_ebgwAppeal" bpmnElement="ebgwAppeal">
                <omgdc:Bounds x="1200" y="505" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_iccAppealWindow" bpmnElement="iccAppealWindow">
                <omgdc:Bounds x="1440" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_iccCustomerAppeal" bpmnElement="iccCustomerAppeal">
                <omgdc:Bounds x="1440" y="632" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utAppealReview" bpmnElement="utAppealReview">
                <omgdc:Bounds x="1680" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwAppealResult" bpmnElement="gwAppealResult">
                <omgdc:Bounds x="1920" y="505" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcRestartOnboarding" bpmnElement="svcRestartOnboarding">
                <omgdc:Bounds x="2160" y="485" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwAppealLimit" bpmnElement="gwAppealLimit">
                <omgdc:Bounds x="2160" y="625" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endNoNotify" bpmnElement="endNoNotify">
                <omgdc:Bounds x="960" y="632" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endWindowClosed" bpmnElement="endWindowClosed">
                <omgdc:Bounds x="1680" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endRestarted" bpmnElement="endRestarted">
                <omgdc:Bounds x="2400" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endFinal" bpmnElement="endFinal">
                <omgdc:Bounds x="2400" y="632" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartRegister" bpmnElement="flowStartRegister">
                <omgdi:waypoint x="276" y="530"/>
                <omgdi:waypoint x="378" y="530"/>
                <omgdi:waypoint x="378" y="170"/>
                <omgdi:waypoint x="480" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRegisterGw" bpmnElement="flowRegisterGw">
                <omgdi:waypoint x="630" y="170"/>
                <omgdi:waypoint x="675" y="170"/>
                <omgdi:waypoint x="675" y="530"/>
                <omgdi:waypoint x="720" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowNoNotify" bpmnElement="flowNoNotify">
                <omgdi:waypoint x="770" y="530"/>
                <omgdi:waypoint x="865" y="530"/>
                <omgdi:waypoint x="865" y="650"/>
                <omgdi:waypoint x="960" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowToNotify" bpmnElement="flowToNotify">
                <omgdi:waypoint x="770" y="530"/>
                <omgdi:waypoint x="960" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowNotifyEbgw" bpmnElement="flowNotifyEbgw">
                <omgdi:waypoint x="1110" y="530"/>
                <omgdi:waypoint x="1200" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEbgwWindow" bpmnElement="flowEbgwWindow">
                <omgdi:waypoint x="1250" y="530"/>
                <omgdi:waypoint x="1440" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEbgwAppeal" bpmnElement="flowEbgwAppeal">
                <omgdi:waypoint x="1250" y="530"/>
                <omgdi:waypoint x="1345" y="530"/>
                <omgdi:waypoint x="1345" y="650"/>
                <omgdi:waypoint x="1440" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowWindowEnd" bpmnElement="flowWindowEnd">
                <omgdi:waypoint x="1476" y="530"/>
                <omgdi:waypoint x="1680" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAppealReview" bpmnElement="flowAppealReview">
                <omgdi:waypoint x="1476" y="650"/>
                <omgdi:waypoint x="1578" y="650"/>
                <omgdi:waypoint x="1578" y="350"/>
                <omgdi:waypoint x="1680" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowReviewGw" bpmnElement="flowReviewGw">
                <omgdi:waypoint x="1830" y="350"/>
                <omgdi:waypoint x="1875" y="350"/>
                <omgdi:waypoint x="1875" y="530"/>
                <omgdi:waypoint x="1920" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAppealSuccess" bpmnElement="flowAppealSuccess">
                <omgdi:waypoint x="1970" y="530"/>
                <omgdi:waypoint x="2160" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRestartEnd" bpmnElement="flowRestartEnd">
                <omgdi:waypoint x="2310" y="530"/>
                <omgdi:waypoint x="2400" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowToAppealLimit" bpmnElement="flowToAppealLimit">
                <omgdi:waypoint x="1970" y="530"/>
                <omgdi:waypoint x="2065" y="530"/>
                <omgdi:waypoint x="2065" y="650"/>
                <omgdi:waypoint x="2160" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowLimitFinal" bpmnElement="flowLimitFinal">
                <omgdi:waypoint x="2210" y="650"/>
                <omgdi:waypoint x="2400" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowBackToReview" bpmnElement="flowBackToReview">
                <omgdi:waypoint x="2185" y="675"/>
                <omgdi:waypoint x="2185" y="715"/>
                <omgdi:waypoint x="1755" y="715"/>
                <omgdi:waypoint x="1755" y="395"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
