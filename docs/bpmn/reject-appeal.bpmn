<?xml version="1.0" encoding="UTF-8"?>
<!--
  P1 拒绝与申诉（文档 3.1，含 8.3-A1 申诉闭环）。
  通知纪律：仅普通拒绝通知客户；制裁/PEP 命中不通知（反洗钱保密义务）。
  申诉闭环（A1 修正后机制）：通知后经 Event-Based Gateway 等申诉（申诉窗口 Timer /
  客户申诉 Message 先到先走）；申诉复审次数上限 3 次（达上限强制终止，防无限期挂起）；
  申诉成功**不回退原实例**（主流程已 None End，引擎不支持在已结束实例上回退）——
  由 delegate 发起新准入实例，businessKey 关联 appealOf=原申请编号实现跨实例追溯，
  新实例按行内制度确定重走起点。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding">

    <message id="msgCustomerAppeal" name="customer-appeal"/>

    <process id="reject-appeal" name="P1 拒绝与申诉">

        <startEvent id="start"/>
        <userTask id="utRejectRegister" name="拒绝原因登记（结构化拒绝码 + 说明）"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="rejection-register"/>
        <exclusiveGateway id="gwHitType" name="制裁/PEP 命中？" default="flowToNotify"/>
        <sendTask id="sendNotifyCustomer" name="通知客户（仅普通拒绝）"
                  flowable:delegateExpression="${customerNotifyDelegate}"/>

        <eventBasedGateway id="ebgwAppeal" name="申诉窗口"/>
        <intermediateCatchEvent id="iccAppealWindow" name="申诉窗口到期">
            <timerEventDefinition>
                <timeDuration>${appealWindow}</timeDuration>
            </timerEventDefinition>
        </intermediateCatchEvent>
        <intermediateCatchEvent id="iccCustomerAppeal" name="客户申诉">
            <messageEventDefinition messageRef="msgCustomerAppeal"/>
        </intermediateCatchEvent>

        <userTask id="utAppealReview" name="申诉受理与复审"
                  flowable:candidateGroups="aml-compliance" flowable:formKey="appeal-review"/>
        <exclusiveGateway id="gwAppealResult" name="申诉结果" default="flowToAppealLimit"/>
        <!-- 8.3-A1：新实例 businessKey=appealOf(原申请编号)；重走起点按行内制度 -->
        <serviceTask id="svcRestartOnboarding" name="发起新准入实例（appealOf 关联）"
                     flowable:delegateExpression="${appealRestartDelegate}"/>
        <exclusiveGateway id="gwAppealLimit" name="申诉次数已达上限？" default="flowBackToReview"/>
        <endEvent id="endNoNotify" name="制裁/PEP 命中（不通知客户）"/>
        <endEvent id="endWindowClosed" name="申诉窗口关闭"/>
        <endEvent id="endRestarted" name="已发起新准入实例"/>
        <endEvent id="endFinal" name="申诉终局（达上限）"/>

        <sequenceFlow id="flowStartRegister" sourceRef="start" targetRef="utRejectRegister"/>
        <sequenceFlow id="flowRegisterGw" sourceRef="utRejectRegister" targetRef="gwHitType"/>
        <sequenceFlow id="flowNoNotify" sourceRef="gwHitType" targetRef="endNoNotify">
            <conditionExpression xsi:type="tFormalExpression">${hitFlag == 'SANCTIONS' || hitFlag == 'PEP'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowToNotify" sourceRef="gwHitType" targetRef="sendNotifyCustomer"/>
        <sequenceFlow id="flowNotifyEbgw" sourceRef="sendNotifyCustomer" targetRef="ebgwAppeal"/>
        <sequenceFlow id="flowEbgwWindow" sourceRef="ebgwAppeal" targetRef="iccAppealWindow"/>
        <sequenceFlow id="flowEbgwAppeal" sourceRef="ebgwAppeal" targetRef="iccCustomerAppeal"/>
        <sequenceFlow id="flowWindowEnd" sourceRef="iccAppealWindow" targetRef="endWindowClosed"/>
        <sequenceFlow id="flowAppealReview" sourceRef="iccCustomerAppeal" targetRef="utAppealReview"/>
        <sequenceFlow id="flowReviewGw" sourceRef="utAppealReview" targetRef="gwAppealResult"/>
        <sequenceFlow id="flowAppealSuccess" sourceRef="gwAppealResult" targetRef="svcRestartOnboarding">
            <conditionExpression xsi:type="tFormalExpression">${appealSuccess == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowRestartEnd" sourceRef="svcRestartOnboarding" targetRef="endRestarted"/>
        <sequenceFlow id="flowToAppealLimit" sourceRef="gwAppealResult" targetRef="gwAppealLimit"/>
        <sequenceFlow id="flowLimitFinal" sourceRef="gwAppealLimit" targetRef="endFinal">
            <conditionExpression xsi:type="tFormalExpression">${appealCount &gt;= 3}</conditionExpression>
        </sequenceFlow>
        <!-- 未达上限：回到复审受理下一轮申诉 -->
        <sequenceFlow id="flowBackToReview" sourceRef="gwAppealLimit" targetRef="utAppealReview"/>

        <laneSet>
            <lane id="laneRm" name="客户经理（RM）">
                <flowNodeRef>utRejectRegister</flowNodeRef>
            </lane>
            <lane id="laneCompliance" name="合规/反洗钱岗">
                <flowNodeRef>utAppealReview</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>gwHitType</flowNodeRef>
                <flowNodeRef>sendNotifyCustomer</flowNodeRef>
                <flowNodeRef>ebgwAppeal</flowNodeRef>
                <flowNodeRef>iccAppealWindow</flowNodeRef>
                <flowNodeRef>iccCustomerAppeal</flowNodeRef>
                <flowNodeRef>gwAppealResult</flowNodeRef>
                <flowNodeRef>svcRestartOnboarding</flowNodeRef>
                <flowNodeRef>gwAppealLimit</flowNodeRef>
                <flowNodeRef>endNoNotify</flowNodeRef>
                <flowNodeRef>endWindowClosed</flowNodeRef>
                <flowNodeRef>endRestarted</flowNodeRef>
                <flowNodeRef>endFinal</flowNodeRef>
            </lane>
        </laneSet>
    </process>
</definitions>
