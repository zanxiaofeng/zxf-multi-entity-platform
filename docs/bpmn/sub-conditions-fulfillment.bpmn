<?xml version="1.0" encoding="UTF-8"?>
<!--
  条件落实子流程（文档 2.5 S4 表格「条件落实 Call Activity」，8.2-D2 配套；
  原为交付件已知 gap，本文件补齐）。
  场景：审批有条件通过（conditionalApproval）——准入获批但附先决条件
  （补充担保/抵押登记、账户限额与非柜面管控措施、追加承诺等）。

  闭环设计：
  1. 登记：svcRegisterConditions 把审批意见中的条件结构化（类型/责任人/dueDate），
     并从配置读取催办周期 conditionsUrgeCycle（SLA 配置化纪律，不写死流程定义）；
  2. 落实：客户经理逐项落实并上传证明；挂**非中断**周期定时边界催办——每次触发
     独立执行催办通知后自行结束（cancelActivity=false 不打断落实任务）；
  3. 复核：审批岗确认（条件由审批方提出，由审批方复核——双人原则）；
  4. 分流：全部落实 → 通知放行；未落实未超期 → 回环继续；超期 → 审批岗决断
     （宽限延期 / 撤销批准落账通知）——不留无限挂起路径（与申诉上限同一完整性纪律）。
  输出 conditionsMet 回传 S4：true → endApproved；false（撤销）→ endRejected。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <process id="sub-conditions-fulfillment" name="条件落实（有条件通过）">
        <laneSet>
            <lane id="laneRm" name="客户经理（RM）">
                <flowNodeRef>utFulfillConditions</flowNodeRef>
            </lane>
            <lane id="laneApprover" name="审批岗">
                <flowNodeRef>utVerifyConditions</flowNodeRef>
                <flowNodeRef>utAdjudicate</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>svcRegisterConditions</flowNodeRef>
                <flowNodeRef>conditionsUrgeTimer</flowNodeRef>
                <flowNodeRef>svcUrge</flowNodeRef>
                <flowNodeRef>endUrge</flowNodeRef>
                <flowNodeRef>gwVerify</flowNodeRef>
                <flowNodeRef>svcNotifyFulfilled</flowNodeRef>
                <flowNodeRef>endFulfilled</flowNodeRef>
                <flowNodeRef>gwOverdue</flowNodeRef>
                <flowNodeRef>gwAdjudicate</flowNodeRef>
                <flowNodeRef>svcExtendDeadline</flowNodeRef>
                <flowNodeRef>svcRevokeApproval</flowNodeRef>
                <flowNodeRef>endRevoked</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start"/>
        <serviceTask id="svcRegisterConditions" name="条件结构化登记（类型/责任人/dueDate，配置读取催办周期）"
                     flowable:delegateExpression="${conditionsRegistrationDelegate}"/>

        <userTask id="utFulfillConditions" name="条件逐项落实与证明材料上传"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="conditions-fulfillment"/>

        <!-- 非中断周期催办：timeCycle 每周期触发一次催办分支，分支独立结束 -->
        <boundaryEvent id="conditionsUrgeTimer" attachedToRef="utFulfillConditions"
                       cancelActivity="false" name="落实周期催办">
            <timerEventDefinition>
                <timeCycle>${conditionsUrgeCycle}</timeCycle>
            </timerEventDefinition>
        </boundaryEvent>
        <serviceTask id="svcUrge" name="催办通知"
                     flowable:delegateExpression="${conditionsUrgeDelegate}"/>
        <endEvent id="endUrge" name="催办分支结束"/>

        <userTask id="utVerifyConditions" name="条件落实复核（审批岗）"
                  flowable:candidateGroups="credit-approval" flowable:formKey="conditions-verify"/>
        <exclusiveGateway id="gwVerify" name="条件是否全部落实" default="flowToOverdueCheck"/>

        <serviceTask id="svcNotifyFulfilled" name="通知条件落实、准入放行"
                     flowable:delegateExpression="${conditionsNotifyDelegate}"/>
        <endEvent id="endFulfilled" name="条件落实完成"/>

        <exclusiveGateway id="gwOverdue" name="是否超期" default="flowBackToFulfill"/>
        <userTask id="utAdjudicate" name="超期决断（宽限/撤销）"
                  flowable:candidateGroups="credit-approval" flowable:formKey="conditions-adjudicate"/>
        <exclusiveGateway id="gwAdjudicate" name="决断结果" default="flowToRevoke"/>
        <serviceTask id="svcExtendDeadline" name="延期登记（更新 dueDate 与催办周期）"
                     flowable:delegateExpression="${conditionsExtendDelegate}"/>
        <serviceTask id="svcRevokeApproval" name="撤销批准（落账 + 通知）"
                     flowable:delegateExpression="${conditionsRevokeDelegate}"/>
        <endEvent id="endRevoked" name="撤销批准"/>

        <sequenceFlow id="flowStartRegister" sourceRef="start" targetRef="svcRegisterConditions"/>
        <sequenceFlow id="flowRegisterFulfill" sourceRef="svcRegisterConditions" targetRef="utFulfillConditions"/>
        <sequenceFlow id="flowUrgeTimer" sourceRef="conditionsUrgeTimer" targetRef="svcUrge"/>
        <sequenceFlow id="flowUrgeEnd" sourceRef="svcUrge" targetRef="endUrge"/>
        <sequenceFlow id="flowFulfillVerify" sourceRef="utFulfillConditions" targetRef="utVerifyConditions"/>
        <sequenceFlow id="flowVerifyGw" sourceRef="utVerifyConditions" targetRef="gwVerify"/>
        <sequenceFlow id="flowMetNotify" sourceRef="gwVerify" targetRef="svcNotifyFulfilled">
            <conditionExpression xsi:type="tFormalExpression">${conditionsMet == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowNotifyEnd" sourceRef="svcNotifyFulfilled" targetRef="endFulfilled"/>
        <sequenceFlow id="flowToOverdueCheck" sourceRef="gwVerify" targetRef="gwOverdue"/>
        <!-- 超期标记 conditionsOverdue 由复核完成回调按 dueDate 客观计算（非人工判断） -->
        <sequenceFlow id="flowOverdueAdjudicate" sourceRef="gwOverdue" targetRef="utAdjudicate">
            <conditionExpression xsi:type="tFormalExpression">${conditionsOverdue == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowBackToFulfill" sourceRef="gwOverdue" targetRef="utFulfillConditions"/>
        <sequenceFlow id="flowAdjudicateGw" sourceRef="utAdjudicate" targetRef="gwAdjudicate"/>
        <sequenceFlow id="flowExtend" sourceRef="gwAdjudicate" targetRef="svcExtendDeadline">
            <conditionExpression xsi:type="tFormalExpression">${adjudication == 'EXTEND'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowExtendBack" sourceRef="svcExtendDeadline" targetRef="utFulfillConditions"/>
        <sequenceFlow id="flowToRevoke" sourceRef="gwAdjudicate" targetRef="svcRevokeApproval"/>
        <sequenceFlow id="flowRevokeEnd" sourceRef="svcRevokeApproval" targetRef="endRevoked"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sub-conditions-fulfillment">
            <bpmndi:BPMNShape id="BPMNShape_laneRm" bpmnElement="laneRm" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="2326" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneApprover" bpmnElement="laneApprover" isHorizontal="true">
                <omgdc:Bounds x="180" y="260" width="2326" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="440" width="2326" height="420"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcRegisterConditions" bpmnElement="svcRegisterConditions">
                <omgdc:Bounds x="480" y="485" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utFulfillConditions" bpmnElement="utFulfillConditions">
                <omgdc:Bounds x="720" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_conditionsUrgeTimer" bpmnElement="conditionsUrgeTimer">
                <omgdc:Bounds x="878" y="155" width="30" height="30"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcUrge" bpmnElement="svcUrge">
                <omgdc:Bounds x="1200" y="485" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endUrge" bpmnElement="endUrge">
                <omgdc:Bounds x="1440" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utVerifyConditions" bpmnElement="utVerifyConditions">
                <omgdc:Bounds x="960" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwVerify" bpmnElement="gwVerify">
                <omgdc:Bounds x="1200" y="625" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcNotifyFulfilled" bpmnElement="svcNotifyFulfilled">
                <omgdc:Bounds x="1440" y="605" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endFulfilled" bpmnElement="endFulfilled">
                <omgdc:Bounds x="1680" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwOverdue" bpmnElement="gwOverdue">
                <omgdc:Bounds x="1440" y="745" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utAdjudicate" bpmnElement="utAdjudicate">
                <omgdc:Bounds x="1680" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwAdjudicate" bpmnElement="gwAdjudicate">
                <omgdc:Bounds x="1920" y="505" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcExtendDeadline" bpmnElement="svcExtendDeadline">
                <omgdc:Bounds x="2160" y="485" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcRevokeApproval" bpmnElement="svcRevokeApproval">
                <omgdc:Bounds x="2160" y="605" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endRevoked" bpmnElement="endRevoked">
                <omgdc:Bounds x="2400" y="512" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartRegister" bpmnElement="flowStartRegister">
                <omgdi:waypoint x="276" y="530"/>
                <omgdi:waypoint x="480" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRegisterFulfill" bpmnElement="flowRegisterFulfill">
                <omgdi:waypoint x="630" y="530"/>
                <omgdi:waypoint x="675" y="530"/>
                <omgdi:waypoint x="675" y="170"/>
                <omgdi:waypoint x="720" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowUrgeTimer" bpmnElement="flowUrgeTimer">
                <omgdi:waypoint x="908" y="170"/>
                <omgdi:waypoint x="1054" y="170"/>
                <omgdi:waypoint x="1054" y="530"/>
                <omgdi:waypoint x="1200" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowUrgeEnd" bpmnElement="flowUrgeEnd">
                <omgdi:waypoint x="1350" y="530"/>
                <omgdi:waypoint x="1440" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowFulfillVerify" bpmnElement="flowFulfillVerify">
                <omgdi:waypoint x="870" y="170"/>
                <omgdi:waypoint x="870" y="143"/>
                <omgdi:waypoint x="915" y="143"/>
                <omgdi:waypoint x="915" y="170"/>
                <omgdi:waypoint x="915" y="350"/>
                <omgdi:waypoint x="960" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowVerifyGw" bpmnElement="flowVerifyGw">
                <omgdi:waypoint x="1110" y="350"/>
                <omgdi:waypoint x="1155" y="350"/>
                <omgdi:waypoint x="1155" y="650"/>
                <omgdi:waypoint x="1200" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowMetNotify" bpmnElement="flowMetNotify">
                <omgdi:waypoint x="1250" y="650"/>
                <omgdi:waypoint x="1440" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowNotifyEnd" bpmnElement="flowNotifyEnd">
                <omgdi:waypoint x="1590" y="650"/>
                <omgdi:waypoint x="1635" y="650"/>
                <omgdi:waypoint x="1635" y="530"/>
                <omgdi:waypoint x="1680" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowToOverdueCheck" bpmnElement="flowToOverdueCheck">
                <omgdi:waypoint x="1250" y="650"/>
                <omgdi:waypoint x="1345" y="650"/>
                <omgdi:waypoint x="1345" y="770"/>
                <omgdi:waypoint x="1440" y="770"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowOverdueAdjudicate" bpmnElement="flowOverdueAdjudicate">
                <omgdi:waypoint x="1490" y="770"/>
                <omgdi:waypoint x="1585" y="770"/>
                <omgdi:waypoint x="1585" y="350"/>
                <omgdi:waypoint x="1680" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowBackToFulfill" bpmnElement="flowBackToFulfill">
                <omgdi:waypoint x="1465" y="795"/>
                <omgdi:waypoint x="1465" y="835"/>
                <omgdi:waypoint x="795" y="835"/>
                <omgdi:waypoint x="795" y="215"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAdjudicateGw" bpmnElement="flowAdjudicateGw">
                <omgdi:waypoint x="1830" y="350"/>
                <omgdi:waypoint x="1875" y="350"/>
                <omgdi:waypoint x="1875" y="530"/>
                <omgdi:waypoint x="1920" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowExtend" bpmnElement="flowExtend">
                <omgdi:waypoint x="1970" y="530"/>
                <omgdi:waypoint x="2160" y="530"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowExtendBack" bpmnElement="flowExtendBack">
                <omgdi:waypoint x="2235" y="575"/>
                <omgdi:waypoint x="2235" y="865"/>
                <omgdi:waypoint x="795" y="865"/>
                <omgdi:waypoint x="795" y="215"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowToRevoke" bpmnElement="flowToRevoke">
                <omgdi:waypoint x="1970" y="530"/>
                <omgdi:waypoint x="2065" y="530"/>
                <omgdi:waypoint x="2065" y="650"/>
                <omgdi:waypoint x="2160" y="650"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRevokeEnd" bpmnElement="flowRevokeEnd">
                <omgdi:waypoint x="2310" y="650"/>
                <omgdi:waypoint x="2355" y="650"/>
                <omgdi:waypoint x="2355" y="530"/>
                <omgdi:waypoint x="2400" y="530"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
