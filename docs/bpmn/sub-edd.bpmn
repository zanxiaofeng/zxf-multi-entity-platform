<?xml version="1.0" encoding="UTF-8"?>
<!--
  强化尽调 EDD 子流程（文档 2.3 表格 sub-edd 行，8.2-D6 已决补齐）。
  触发条件：风险评级 HIGH 或 S2「结构复杂」标记（11 号令第 27/28 条情形）。
  措施执行 = 客户经理 User Task（第 28 条措施清单，含来源证明材料要求）；
  第五项「需获得高级管理层的批准」落为高管会签 User Task（多实例并行，一票否决：
  任一反对即结束——completionCondition 依赖 taskListener 计票，同 S4 模式）。
  eddApproved 经 S3a 的 callActivity out 链透传至主流程，否决时主流程按拒绝走 P1。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding">

    <process id="sub-edd" name="强化尽调（EDD）与高级管理层批准">

        <startEvent id="start"/>
        <userTask id="utEddMeasures" name="EDD 措施执行（11 号令第 28 条清单）"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="edd-measures"/>
        <userTask id="utSeniorSignoff" name="高级管理层批准（会签）"
                  flowable:assignee="${approver}" flowable:formKey="edd-signoff">
            <extensionElements>
                <flowable:taskListener event="complete" delegateExpression="${approvalResultListener}"/>
            </extensionElements>
            <multiInstanceLoopCharacteristics isSequential="false"
                flowable:collection="${eddApprovalService.resolve(execution)}"
                flowable:elementVariable="approver">
                <!-- EDD 批准口径：全员通过 + 任一反对提前结束（一票否决） -->
                <completionCondition>${rejectCount &gt; 0 || nrOfCompletedInstances == nrOfInstances}</completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>
        <exclusiveGateway id="gwEddResult" name="高管批准结果" default="flowEddRejected"/>
        <endEvent id="endApproved"/>
        <endEvent id="endRejected"/>

        <sequenceFlow id="flowStartMeasures" sourceRef="start" targetRef="utEddMeasures"/>
        <sequenceFlow id="flowMeasuresSignoff" sourceRef="utEddMeasures" targetRef="utSeniorSignoff"/>
        <sequenceFlow id="flowSignoffGw" sourceRef="utSeniorSignoff" targetRef="gwEddResult"/>
        <sequenceFlow id="flowEddApproved" sourceRef="gwEddResult" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression">${eddApproved == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowEddRejected" sourceRef="gwEddResult" targetRef="endRejected"/>

        <laneSet>
            <lane id="laneRm" name="客户经理（RM）">
                <flowNodeRef>utEddMeasures</flowNodeRef>
            </lane>
            <lane id="laneSeniorMgmt" name="高级管理层">
                <flowNodeRef>utSeniorSignoff</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>gwEddResult</flowNodeRef>
                <flowNodeRef>endApproved</flowNodeRef>
                <flowNodeRef>endRejected</flowNodeRef>
            </lane>
        </laneSet>
    </process>
</definitions>
