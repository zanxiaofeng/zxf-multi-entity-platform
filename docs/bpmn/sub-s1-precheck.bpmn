<?xml version="1.0" encoding="UTF-8"?>
<!--
  S1 受理与资料预检（文档 2.1）。客户类型 = 对公/集团（8.2-D5：同业独立流程定义）；
  客户类型、业务品种在发起表单一次采集，不单独建 Task；申请额度此处采集，供 S3b 额度适配输入。
  补件循环：Exclusive Gateway 回退，发生在本子流程内部、不污染主图（8.2-D2 配套纪律）；
  若补件路径膨胀（多轮补件、客户侧等待计时）再抽 sub-supplement（系统设计文档表 4-1）。

  DMN：document-checklist（hit policy = COLLECT，多维度资料要求汇总）；输入按同名
  流程变量自动匹配（customerType/businessType），BRT 引用方式见四-1
  （flowable:decisionTableReferenceKey，DMN 独立部署、独立版本化）。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <process id="sub-s1-precheck" name="S1 受理与资料预检">

        <startEvent id="start"/>
        <!-- 发起表单：flowable:formKey 指向自建表单中心（Flowable 8 无 Form 引擎，8.1 修订 #2） -->
        <userTask id="utApply" name="发起准入申请"
                  flowable:assignee="${initiator}" flowable:formKey="onboarding-application"/>
        <userTask id="utCollect" name="资料收集与预检（上传证照与授权文件）"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="onboarding-documents"/>
        <businessRuleTask id="brtChecklist" name="资料清单匹配（DMN）"
                          flowable:decisionTableReferenceKey="document-checklist"/>
        <!-- COLLECT 多命中结果以 JSON 数组存入决策 key 命名变量；「资料齐全」是集合
             比对（已交 ⊇ 必需），归 delegate 而非 DMN（见 document-checklist.dmn 注释） -->
        <serviceTask id="svcCheckDocuments" name="资料齐全比对（已交 ⊇ 必需清单）"
                     flowable:delegateExpression="${documentsCheckDelegate}"/>
        <exclusiveGateway id="gwDocsComplete" name="资料是否齐全" default="flowToSupplement"/>
        <userTask id="utSupplement" name="补件"
                  flowable:candidateGroups="relationship-managers" flowable:formKey="onboarding-supplement"/>
        <endEvent id="end"/>

        <sequenceFlow id="flowStartApply" sourceRef="start" targetRef="utApply"/>
        <sequenceFlow id="flowApplyCollect" sourceRef="utApply" targetRef="utCollect"/>
        <sequenceFlow id="flowCollectCheck" sourceRef="utCollect" targetRef="brtChecklist"/>
        <sequenceFlow id="flowCheckSvc" sourceRef="brtChecklist" targetRef="svcCheckDocuments"/>
        <sequenceFlow id="flowCheckGw" sourceRef="svcCheckDocuments" targetRef="gwDocsComplete"/>
        <sequenceFlow id="flowGwEnd" sourceRef="gwDocsComplete" targetRef="end">
            <conditionExpression xsi:type="tFormalExpression">${documentsComplete == true}</conditionExpression>
        </sequenceFlow>
        <!-- 回退闭环：补件完成后回到资料收集重新预检（2.1 节 Loop） -->
        <sequenceFlow id="flowToSupplement" sourceRef="gwDocsComplete" targetRef="utSupplement"/>
        <sequenceFlow id="flowSupplementBack" sourceRef="utSupplement" targetRef="utCollect"/>

        <laneSet>
            <lane id="laneRm" name="客户经理（RM）">
                <flowNodeRef>utApply</flowNodeRef>
                <flowNodeRef>utCollect</flowNodeRef>
                <flowNodeRef>utSupplement</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>brtChecklist</flowNodeRef>
                <flowNodeRef>svcCheckDocuments</flowNodeRef>
                <flowNodeRef>gwDocsComplete</flowNodeRef>
                <flowNodeRef>end</flowNodeRef>
            </lane>
        </laneSet>
    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sub-s1-precheck">
            <bpmndi:BPMNShape id="BPMNShape_laneRm" bpmnElement="laneRm" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="1606" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="260" width="1606" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utApply" bpmnElement="utApply">
                <omgdc:Bounds x="480" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utCollect" bpmnElement="utCollect">
                <omgdc:Bounds x="720" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtChecklist" bpmnElement="brtChecklist">
                <omgdc:Bounds x="960" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcCheckDocuments" bpmnElement="svcCheckDocuments">
                <omgdc:Bounds x="1200" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwDocsComplete" bpmnElement="gwDocsComplete">
                <omgdc:Bounds x="1440" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utSupplement" bpmnElement="utSupplement">
                <omgdc:Bounds x="240" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
                <omgdc:Bounds x="1680" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartApply" bpmnElement="flowStartApply">
                <omgdi:waypoint x="276" y="350"/>
                <omgdi:waypoint x="378" y="350"/>
                <omgdi:waypoint x="378" y="170"/>
                <omgdi:waypoint x="480" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowApplyCollect" bpmnElement="flowApplyCollect">
                <omgdi:waypoint x="630" y="170"/>
                <omgdi:waypoint x="720" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowCollectCheck" bpmnElement="flowCollectCheck">
                <omgdi:waypoint x="870" y="170"/>
                <omgdi:waypoint x="915" y="170"/>
                <omgdi:waypoint x="915" y="350"/>
                <omgdi:waypoint x="960" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowCheckSvc" bpmnElement="flowCheckSvc">
                <omgdi:waypoint x="1110" y="350"/>
                <omgdi:waypoint x="1200" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowCheckGw" bpmnElement="flowCheckGw">
                <omgdi:waypoint x="1350" y="350"/>
                <omgdi:waypoint x="1440" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowGwEnd" bpmnElement="flowGwEnd">
                <omgdi:waypoint x="1490" y="350"/>
                <omgdi:waypoint x="1680" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowToSupplement" bpmnElement="flowToSupplement">
                <omgdi:waypoint x="1465" y="375"/>
                <omgdi:waypoint x="1465" y="415"/>
                <omgdi:waypoint x="315" y="415"/>
                <omgdi:waypoint x="315" y="215"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowSupplementBack" bpmnElement="flowSupplementBack">
                <omgdi:waypoint x="390" y="170"/>
                <omgdi:waypoint x="720" y="170"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
