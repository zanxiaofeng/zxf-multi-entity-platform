<?xml version="1.0" encoding="UTF-8"?>
<!--
  S3b 准入规则校验（文档 2.4）。六张 DMN 按业务条线拆分、各条线独立维护、
  模型上多个 Business Rule Task 串联（8.1 修订 #3：Flowable 无 DRG，多表编排
  以 BPMN 多个 Decision Task 串联为主流——完全指南 20.2/23）。
  DMN 独立部署独立版本化：改规则不发流程（四-1），对齐系统设计文档表 2-1
  「监管依据密集换版 → 规则必须外置」的结论。
  与 S3a 并行执行（主流程并行网关），故输入不含 riskLevel；
  例外审批触发（exception-trigger）输出 eligibilityPassed 与例外标记。
  兜底：各表 `-` 全匹配兜底行保证表完备（四-1）。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <process id="sub-s3b-eligibility" name="S3b 准入规则校验">
        <laneSet>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>svcAssembleInput</flowNodeRef>
                <flowNodeRef>brtIndustry</flowNodeRef>
                <flowNodeRef>brtRegion</flowNodeRef>
                <flowNodeRef>brtLimit</flowNodeRef>
                <flowNodeRef>brtProduct</flowNodeRef>
                <flowNodeRef>brtBlacklist</flowNodeRef>
                <flowNodeRef>brtException</flowNodeRef>
                <flowNodeRef>end</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start"/>
        <!-- 数据装配：从业务库客户属性预置 industryCode/regionCode/productCode/
             isCrossBorder，名单库比对预置 blacklistHit——DMN 只做条件判断不做查询
             （见各 .dmn 注释与 blacklist-check.dmn 分工边界） -->
        <serviceTask id="svcAssembleInput" name="校验输入装配（业务库属性/名单库比对预置）"
                     flowable:delegateExpression="${s3bInputAssemblyDelegate}"/>
        <serviceTask id="brtIndustry" name="行业政策校验（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="industry-policy"/>
            </extensionElements>
        </serviceTask>
        <serviceTask id="brtRegion" name="区域政策校验（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="region-policy"/>
            </extensionElements>
        </serviceTask>
        <serviceTask id="brtLimit" name="额度适配校验（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="limit-eligibility"/>
            </extensionElements>
        </serviceTask>
        <serviceTask id="brtProduct" name="产品适配校验（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="product-fit"/>
            </extensionElements>
        </serviceTask>
        <serviceTask id="brtBlacklist" name="黑名单比对（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="blacklist-check"/>
            </extensionElements>
        </serviceTask>
        <serviceTask id="brtException" name="例外审批触发（DMN）" flowable:type="dmn">
            <extensionElements>
                <flowable:field name="decisionTableReferenceKey" stringValue="exception-trigger"/>
            </extensionElements>
        </serviceTask>
        <endEvent id="end"/>

        <sequenceFlow id="flowStartAssemble" sourceRef="start" targetRef="svcAssembleInput"/>
        <sequenceFlow id="flowAssembleIndustry" sourceRef="svcAssembleInput" targetRef="brtIndustry"/>
        <sequenceFlow id="flowIndustryRegion" sourceRef="brtIndustry" targetRef="brtRegion"/>
        <sequenceFlow id="flowRegionLimit" sourceRef="brtRegion" targetRef="brtLimit"/>
        <sequenceFlow id="flowLimitProduct" sourceRef="brtLimit" targetRef="brtProduct"/>
        <sequenceFlow id="flowProductBlacklist" sourceRef="brtProduct" targetRef="brtBlacklist"/>
        <sequenceFlow id="flowBlacklistException" sourceRef="brtBlacklist" targetRef="brtException"/>
        <sequenceFlow id="flowExceptionEnd" sourceRef="brtException" targetRef="end"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sub-s3b-eligibility">
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="2086" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="152" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcAssembleInput" bpmnElement="svcAssembleInput">
                <omgdc:Bounds x="480" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtIndustry" bpmnElement="brtIndustry">
                <omgdc:Bounds x="720" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtRegion" bpmnElement="brtRegion">
                <omgdc:Bounds x="960" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtLimit" bpmnElement="brtLimit">
                <omgdc:Bounds x="1200" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtProduct" bpmnElement="brtProduct">
                <omgdc:Bounds x="1440" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtBlacklist" bpmnElement="brtBlacklist">
                <omgdc:Bounds x="1680" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtException" bpmnElement="brtException">
                <omgdc:Bounds x="1920" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
                <omgdc:Bounds x="2160" y="152" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartAssemble" bpmnElement="flowStartAssemble">
                <omgdi:waypoint x="276" y="170"/>
                <omgdi:waypoint x="480" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAssembleIndustry" bpmnElement="flowAssembleIndustry">
                <omgdi:waypoint x="630" y="170"/>
                <omgdi:waypoint x="720" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowIndustryRegion" bpmnElement="flowIndustryRegion">
                <omgdi:waypoint x="870" y="170"/>
                <omgdi:waypoint x="960" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRegionLimit" bpmnElement="flowRegionLimit">
                <omgdi:waypoint x="1110" y="170"/>
                <omgdi:waypoint x="1200" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowLimitProduct" bpmnElement="flowLimitProduct">
                <omgdi:waypoint x="1350" y="170"/>
                <omgdi:waypoint x="1440" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowProductBlacklist" bpmnElement="flowProductBlacklist">
                <omgdi:waypoint x="1590" y="170"/>
                <omgdi:waypoint x="1680" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowBlacklistException" bpmnElement="flowBlacklistException">
                <omgdi:waypoint x="1830" y="170"/>
                <omgdi:waypoint x="1920" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowExceptionEnd" bpmnElement="flowExceptionEnd">
                <omgdi:waypoint x="2070" y="170"/>
                <omgdi:waypoint x="2160" y="170"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
