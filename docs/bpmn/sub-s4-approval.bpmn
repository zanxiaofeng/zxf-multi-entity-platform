<?xml version="1.0" encoding="UTF-8"?>
<!--
  S4 审批决策（文档 2.5）。会签规则经 DMN 输出参数驱动（8.1 修订 #9）：
  approval-routing 输出 approverList 与规则，svcAssembleParams 由领域服务按人数换算
  passThresholdCount（全部通过=人数/多数通过=过半）与 vetoEnabled（一票否决开关），
  completionCondition 只消费变量——三种规则统一映射：全部通过 = veto+全员阈值；
  多数通过 = 阈值过半；一票否决 = veto + 全员阈值。
  计票：taskListener（complete 事件）在领域服务累加 approveCount/rejectCount/
  abstainCount（弃权是否计入分母由领域服务换算阈值时按行内制度决定）。
  completionCondition 提前结束时剩余待办被引擎删除（delete 事件）——listener 侧
  须作废通知与留痕（2.5 纪律）。超时升级：中断型定时边界挂多实例审批任务，
  SLA 经变量配置化（不写入流程定义）；触发后整体转上级复批。
  有条件通过 → Call Activity「条件落实」（文档 2.5 表格）；目标子流程
  sub-conditions-fulfillment 未在本批交付（文档六章目录未含），落地时补定义。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <process id="sub-s4-approval" name="S4 审批决策">

        <startEvent id="start"/>
        <!-- 审批输入装配：isGroupCustomer/isCrossBorder 由业务库预置（approval-routing.dmn 输入） -->
        <serviceTask id="svcAssembleApprovalInput" name="审批输入装配（集团/跨境标记）"
                     flowable:delegateExpression="${approvalInputAssemblyDelegate}"/>
        <businessRuleTask id="brtRouting" name="审批路由（DMN：层级/人员集合/会签规则）"
                          flowable:decisionTableReferenceKey="approval-routing"/>
        <!-- 领域服务换算阈值与开关（public 方法、参数含 DelegateExecution、
             捕获业务异常 fallback 默认审批链——2.5 纪律） -->
        <serviceTask id="svcAssembleParams" name="审批参数装配（passThresholdCount/vetoEnabled）"
                     flowable:delegateExpression="${approvalParamDelegate}"/>

        <!-- 多实例会签：collection 表达式调 Spring bean；elementVariable 注入每实例审批人 -->
        <userTask id="utApprove" name="审批任务" flowable:assignee="${approver}" flowable:formKey="approval">
            <extensionElements>
                <flowable:taskListener event="complete" delegateExpression="${approvalResultListener}"/>
            </extensionElements>
            <multiInstanceLoopCharacteristics isSequential="false"
                flowable:collection="${approvalService.resolveApprovers(execution)}"
                flowable:elementVariable="approver">
                <completionCondition>${(vetoEnabled &amp;&amp; rejectCount &gt; 0) || approveCount &gt;= passThresholdCount}</completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <!-- 中断型定时边界：超时取消全部剩余审批实例，转上级复批（16.5） -->
        <boundaryEvent id="approveTimeout" attachedToRef="utApprove" name="审批超时升级">
            <timerEventDefinition>
                <timeDuration>${approvalSla}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>
        <userTask id="utEscalate" name="上级审批（超时转报）"
                  flowable:candidateGroups="senior-management" flowable:formKey="approval"/>
        <exclusiveGateway id="gwEscalated" name="上级审批结果" default="flowEscRejected"/>

        <exclusiveGateway id="gwResult" name="审批结果" default="flowRejected"/>
        <exclusiveGateway id="gwConditional" name="是否有条件通过" default="flowUnconditionalEnd"/>
        <callActivity id="callConditions" name="条件落实" calledElement="sub-conditions-fulfillment">
            <extensionElements>
                <flowable:in source="applyNo"/>
                <flowable:out source="conditionsMet"/>
            </extensionElements>
        </callActivity>
        <!-- 条件落实结果分流（sub-conditions-fulfillment 补齐后新增）：
             全部落实 → 通过；撤销批准（条件未落实超期决断撤销）→ 按拒绝处理 -->
        <exclusiveGateway id="gwConditionsOutcome" name="条件落实结果" default="flowConditionsRejected"/>
        <endEvent id="endApproved"/>
        <endEvent id="endRejected"/>

        <sequenceFlow id="flowStartAssemble" sourceRef="start" targetRef="svcAssembleApprovalInput"/>
        <sequenceFlow id="flowAssembleRouting" sourceRef="svcAssembleApprovalInput" targetRef="brtRouting"/>
        <sequenceFlow id="flowRoutingParams" sourceRef="brtRouting" targetRef="svcAssembleParams"/>
        <sequenceFlow id="flowParamsApprove" sourceRef="svcAssembleParams" targetRef="utApprove"/>
        <sequenceFlow id="flowTimeoutEscalate" sourceRef="approveTimeout" targetRef="utEscalate"/>
        <sequenceFlow id="flowEscalateGw" sourceRef="utEscalate" targetRef="gwEscalated"/>
        <sequenceFlow id="flowEscApproved" sourceRef="gwEscalated" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowEscRejected" sourceRef="gwEscalated" targetRef="endRejected"/>
        <sequenceFlow id="flowApproveGw" sourceRef="utApprove" targetRef="gwResult"/>
        <sequenceFlow id="flowApproved" sourceRef="gwResult" targetRef="gwConditional">
            <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowRejected" sourceRef="gwResult" targetRef="endRejected"/>
        <sequenceFlow id="flowConditional" sourceRef="gwConditional" targetRef="callConditions">
            <conditionExpression xsi:type="tFormalExpression">${conditionalApproval == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowConditionsGw" sourceRef="callConditions" targetRef="gwConditionsOutcome"/>
        <sequenceFlow id="flowConditionsApproved" sourceRef="gwConditionsOutcome" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression">${conditionsMet == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flowConditionsRejected" sourceRef="gwConditionsOutcome" targetRef="endRejected"/>
        <sequenceFlow id="flowUnconditionalEnd" sourceRef="gwConditional" targetRef="endApproved"/>

        <laneSet>
            <lane id="laneApprover" name="审批岗">
                <flowNodeRef>utApprove</flowNodeRef>
                <flowNodeRef>utEscalate</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>svcAssembleApprovalInput</flowNodeRef>
                <flowNodeRef>brtRouting</flowNodeRef>
                <flowNodeRef>svcAssembleParams</flowNodeRef>
                <flowNodeRef>approveTimeout</flowNodeRef>
                <flowNodeRef>gwEscalated</flowNodeRef>
                <flowNodeRef>gwResult</flowNodeRef>
                <flowNodeRef>gwConditional</flowNodeRef>
                <flowNodeRef>callConditions</flowNodeRef>
                <flowNodeRef>gwConditionsOutcome</flowNodeRef>
                <flowNodeRef>endApproved</flowNodeRef>
                <flowNodeRef>endRejected</flowNodeRef>
            </lane>
        </laneSet>
    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sub-s4-approval">
            <bpmndi:BPMNShape id="BPMNShape_laneApprover" bpmnElement="laneApprover" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="2326" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="260" width="2326" height="300"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcAssembleApprovalInput" bpmnElement="svcAssembleApprovalInput">
                <omgdc:Bounds x="480" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_brtRouting" bpmnElement="brtRouting">
                <omgdc:Bounds x="720" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcAssembleParams" bpmnElement="svcAssembleParams">
                <omgdc:Bounds x="960" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utApprove" bpmnElement="utApprove">
                <omgdc:Bounds x="1200" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_approveTimeout" bpmnElement="approveTimeout">
                <omgdc:Bounds x="1362" y="207" width="30" height="30"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utEscalate" bpmnElement="utEscalate">
                <omgdc:Bounds x="1680" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwEscalated" bpmnElement="gwEscalated">
                <omgdc:Bounds x="1920" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwResult" bpmnElement="gwResult">
                <omgdc:Bounds x="1440" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwConditional" bpmnElement="gwConditional">
                <omgdc:Bounds x="1680" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_callConditions" bpmnElement="callConditions">
                <omgdc:Bounds x="1920" y="425" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_gwConditionsOutcome" bpmnElement="gwConditionsOutcome">
                <omgdc:Bounds x="2160" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endApproved" bpmnElement="endApproved">
                <omgdc:Bounds x="2400" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endRejected" bpmnElement="endRejected">
                <omgdc:Bounds x="2400" y="452" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartAssemble" bpmnElement="flowStartAssemble">
                <omgdi:waypoint x="276" y="350"/>
                <omgdi:waypoint x="480" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAssembleRouting" bpmnElement="flowAssembleRouting">
                <omgdi:waypoint x="630" y="350"/>
                <omgdi:waypoint x="720" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRoutingParams" bpmnElement="flowRoutingParams">
                <omgdi:waypoint x="870" y="350"/>
                <omgdi:waypoint x="960" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowParamsApprove" bpmnElement="flowParamsApprove">
                <omgdi:waypoint x="1110" y="350"/>
                <omgdi:waypoint x="1155" y="350"/>
                <omgdi:waypoint x="1155" y="170"/>
                <omgdi:waypoint x="1200" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowTimeoutEscalate" bpmnElement="flowTimeoutEscalate">
                <omgdi:waypoint x="1392" y="222"/>
                <omgdi:waypoint x="1536" y="222"/>
                <omgdi:waypoint x="1536" y="170"/>
                <omgdi:waypoint x="1680" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEscalateGw" bpmnElement="flowEscalateGw">
                <omgdi:waypoint x="1830" y="170"/>
                <omgdi:waypoint x="1875" y="170"/>
                <omgdi:waypoint x="1875" y="350"/>
                <omgdi:waypoint x="1920" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEscApproved" bpmnElement="flowEscApproved">
                <omgdi:waypoint x="1970" y="350"/>
                <omgdi:waypoint x="2400" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEscRejected" bpmnElement="flowEscRejected">
                <omgdi:waypoint x="1970" y="350"/>
                <omgdi:waypoint x="2185" y="350"/>
                <omgdi:waypoint x="2185" y="470"/>
                <omgdi:waypoint x="2400" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowApproveGw" bpmnElement="flowApproveGw">
                <omgdi:waypoint x="1350" y="170"/>
                <omgdi:waypoint x="1395" y="170"/>
                <omgdi:waypoint x="1395" y="350"/>
                <omgdi:waypoint x="1440" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowApproved" bpmnElement="flowApproved">
                <omgdi:waypoint x="1490" y="350"/>
                <omgdi:waypoint x="1680" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowRejected" bpmnElement="flowRejected">
                <omgdi:waypoint x="1490" y="350"/>
                <omgdi:waypoint x="1945" y="350"/>
                <omgdi:waypoint x="1945" y="470"/>
                <omgdi:waypoint x="2400" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowConditional" bpmnElement="flowConditional">
                <omgdi:waypoint x="1730" y="350"/>
                <omgdi:waypoint x="1825" y="350"/>
                <omgdi:waypoint x="1825" y="470"/>
                <omgdi:waypoint x="1920" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowConditionsGw" bpmnElement="flowConditionsGw">
                <omgdi:waypoint x="2070" y="470"/>
                <omgdi:waypoint x="2115" y="470"/>
                <omgdi:waypoint x="2115" y="350"/>
                <omgdi:waypoint x="2160" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowConditionsApproved" bpmnElement="flowConditionsApproved">
                <omgdi:waypoint x="2210" y="350"/>
                <omgdi:waypoint x="2400" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowConditionsRejected" bpmnElement="flowConditionsRejected">
                <omgdi:waypoint x="2210" y="350"/>
                <omgdi:waypoint x="2305" y="350"/>
                <omgdi:waypoint x="2305" y="470"/>
                <omgdi:waypoint x="2400" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowUnconditionalEnd" bpmnElement="flowUnconditionalEnd">
                <omgdi:waypoint x="1730" y="350"/>
                <omgdi:waypoint x="2400" y="350"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
