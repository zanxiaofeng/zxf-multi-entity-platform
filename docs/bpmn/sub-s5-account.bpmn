<?xml version="1.0" encoding="UTF-8"?>
<!--
  S5 签约、开户与归档（文档 2.6）。审批通过即通知客户（S5 入口即发、不等签约与开户完成，8.4-B6）；
  开户指令幂等键 = 申请编号+账户类型，业务表唯一索引兜底（2.6）；
  回执等待用 Event-Based Gateway：开户回执（Message Catch，message name:
  account-open-result，messageEventReceived 按消息名+applyNo correlation 定位实例）
  与回执超时（Timer）先到先走——事件网关出口只能接中间捕获事件（完全指南 §9），
  避免流程实例长期挂起（2.6）；归档 = Service Task 调影像系统 + 业务库留档，
  Data Store 仅建模标注、无运行时持久化语义（8.1 修订 #11）。
  通知经 Send Task + 自定义 delegate 实现（Flowable 8 Send Task 支持自定义实现——完全指南 8.1）。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">

    <message id="msgAccountOpenResult" name="account-open-result"/>

    <process id="sub-s5-account" name="S5 签约、开户与归档">
        <laneSet>
            <lane id="laneOperations" name="运营/开户岗">
                <flowNodeRef>utContract</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>sendNotifyCustomer</flowNodeRef>
                <flowNodeRef>svcOpenAccount</flowNodeRef>
                <flowNodeRef>ebgwReceipt</flowNodeRef>
                <flowNodeRef>iccAccountResult</flowNodeRef>
                <flowNodeRef>iccReceiptTimeout</flowNodeRef>
                <flowNodeRef>svcArchive</flowNodeRef>
                <flowNodeRef>svcReceiptAlert</flowNodeRef>
                <flowNodeRef>end</flowNodeRef>
                <flowNodeRef>endTimeoutHandled</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="start"/>
        <userTask id="utContract" name="签约准备（合同/印鉴）"
                  flowable:candidateGroups="account-operations" flowable:formKey="contract-signing"/>
        <serviceTask id="sendNotifyCustomer" name="通知客户（审批通过即通知，入口即发）"
                  flowable:delegateExpression="${customerNotifyDelegate}"/>
        <serviceTask id="svcOpenAccount" name="开户指令（核心系统，幂等键=申请编号+账户类型）"
                     flowable:async="true" flowable:delegateExpression="${accountOpenDelegate}">
            <extensionElements>
                <flowable:failedJobRetryTimeCycle>R3/PT10M</flowable:failedJobRetryTimeCycle>
            </extensionElements>
        </serviceTask>

        <!-- 等回执或超时，先到先走；超时时长配置化 -->
        <eventBasedGateway id="ebgwReceipt" name="等待开户回执/超时"/>
        <intermediateCatchEvent id="iccAccountResult" name="开户回执">
            <messageEventDefinition messageRef="msgAccountOpenResult"/>
        </intermediateCatchEvent>
        <intermediateCatchEvent id="iccReceiptTimeout" name="回执超时">
            <timerEventDefinition>
                <timeDuration>${accountReceiptTimeout}</timeDuration>
            </timerEventDefinition>
        </intermediateCatchEvent>

        <serviceTask id="svcArchive" name="归档（影像系统 + 业务库留档）"
                     flowable:async="true" flowable:delegateExpression="${accountArchiveDelegate}"/>
        <serviceTask id="svcReceiptAlert" name="回执超时告警（转人工）"
                     flowable:delegateExpression="${accountReceiptTimeoutDelegate}"/>
        <endEvent id="end"/>
        <endEvent id="endTimeoutHandled"/>

        <!-- 8.4-B6：审批通过即通知——S5 入口即发（异步动作秒级，不阻塞签约准备），不等签约与开户 -->
        <sequenceFlow id="flowStartNotify" sourceRef="start" targetRef="sendNotifyCustomer"/>
        <sequenceFlow id="flowNotifyContract" sourceRef="sendNotifyCustomer" targetRef="utContract"/>
        <sequenceFlow id="flowContractOpen" sourceRef="utContract" targetRef="svcOpenAccount"/>
        <sequenceFlow id="flowOpenEbgw" sourceRef="svcOpenAccount" targetRef="ebgwReceipt"/>
        <sequenceFlow id="flowEbgwResult" sourceRef="ebgwReceipt" targetRef="iccAccountResult"/>
        <sequenceFlow id="flowEbgwTimeout" sourceRef="ebgwReceipt" targetRef="iccReceiptTimeout"/>
        <sequenceFlow id="flowResultArchive" sourceRef="iccAccountResult" targetRef="svcArchive"/>
        <sequenceFlow id="flowArchiveEnd" sourceRef="svcArchive" targetRef="end"/>
        <sequenceFlow id="flowTimeoutAlert" sourceRef="iccReceiptTimeout" targetRef="svcReceiptAlert"/>
        <sequenceFlow id="flowAlertEnd" sourceRef="svcReceiptAlert" targetRef="endTimeoutHandled"/>

    </process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_1">
        <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sub-s5-account">
            <bpmndi:BPMNShape id="BPMNShape_laneOperations" bpmnElement="laneOperations" isHorizontal="true">
                <omgdc:Bounds x="180" y="80" width="1846" height="180"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_laneSystem" bpmnElement="laneSystem" isHorizontal="true">
                <omgdc:Bounds x="180" y="260" width="1846" height="300"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="start">
                <omgdc:Bounds x="240" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_utContract" bpmnElement="utContract">
                <omgdc:Bounds x="720" y="125" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_sendNotifyCustomer" bpmnElement="sendNotifyCustomer">
                <omgdc:Bounds x="480" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcOpenAccount" bpmnElement="svcOpenAccount">
                <omgdc:Bounds x="960" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_ebgwReceipt" bpmnElement="ebgwReceipt">
                <omgdc:Bounds x="1200" y="325" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_iccAccountResult" bpmnElement="iccAccountResult">
                <omgdc:Bounds x="1440" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_iccReceiptTimeout" bpmnElement="iccReceiptTimeout">
                <omgdc:Bounds x="1440" y="452" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcArchive" bpmnElement="svcArchive">
                <omgdc:Bounds x="1680" y="305" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_svcReceiptAlert" bpmnElement="svcReceiptAlert">
                <omgdc:Bounds x="1680" y="425" width="150" height="90"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_end" bpmnElement="end">
                <omgdc:Bounds x="1920" y="332" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="BPMNShape_endTimeoutHandled" bpmnElement="endTimeoutHandled">
                <omgdc:Bounds x="1920" y="452" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="BPMNEdge_flowStartNotify" bpmnElement="flowStartNotify">
                <omgdi:waypoint x="276" y="350"/>
                <omgdi:waypoint x="480" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowNotifyContract" bpmnElement="flowNotifyContract">
                <omgdi:waypoint x="630" y="350"/>
                <omgdi:waypoint x="675" y="350"/>
                <omgdi:waypoint x="675" y="170"/>
                <omgdi:waypoint x="720" y="170"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowContractOpen" bpmnElement="flowContractOpen">
                <omgdi:waypoint x="870" y="170"/>
                <omgdi:waypoint x="915" y="170"/>
                <omgdi:waypoint x="915" y="350"/>
                <omgdi:waypoint x="960" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowOpenEbgw" bpmnElement="flowOpenEbgw">
                <omgdi:waypoint x="1110" y="350"/>
                <omgdi:waypoint x="1200" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEbgwResult" bpmnElement="flowEbgwResult">
                <omgdi:waypoint x="1250" y="350"/>
                <omgdi:waypoint x="1440" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowEbgwTimeout" bpmnElement="flowEbgwTimeout">
                <omgdi:waypoint x="1250" y="350"/>
                <omgdi:waypoint x="1345" y="350"/>
                <omgdi:waypoint x="1345" y="470"/>
                <omgdi:waypoint x="1440" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowResultArchive" bpmnElement="flowResultArchive">
                <omgdi:waypoint x="1476" y="350"/>
                <omgdi:waypoint x="1680" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowArchiveEnd" bpmnElement="flowArchiveEnd">
                <omgdi:waypoint x="1830" y="350"/>
                <omgdi:waypoint x="1920" y="350"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowTimeoutAlert" bpmnElement="flowTimeoutAlert">
                <omgdi:waypoint x="1476" y="470"/>
                <omgdi:waypoint x="1680" y="470"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="BPMNEdge_flowAlertEnd" bpmnElement="flowAlertEnd">
                <omgdi:waypoint x="1830" y="470"/>
                <omgdi:waypoint x="1920" y="470"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
