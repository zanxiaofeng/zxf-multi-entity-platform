<?xml version="1.0" encoding="UTF-8"?>
<!--
  S5 签约、开户与归档（文档 2.6）。审批通过即通知客户（不等开户完成）；
  开户指令幂等键 = 申请编号+账户类型，业务表唯一索引兜底（2.6）；
  回执等待用 Event-Based Gateway：开户回执（Message Catch，message name:
  account-open-result，messageEventReceived 按消息名+applyNo correlation 定位实例）
  与回执超时（Timer）先到先走——事件网关出口只能接中间捕获事件（完全指南 §9），
  避免流程实例长期挂起（2.6）；归档 = Service Task 调影像系统 + 业务库留档，
  Data Store 仅建模标注、无运行时持久化语义（8.1 修订 #11）。
  通知经 Send Task + 自定义 delegate 实现（Flowable 8 Send Task 支持自定义实现——完全指南 8.1）。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/onboarding">

    <message id="msgAccountOpenResult" name="account-open-result"/>

    <process id="sub-s5-account" name="S5 签约、开户与归档">

        <startEvent id="start"/>
        <userTask id="utContract" name="签约准备（合同/印鉴）"
                  flowable:candidateGroups="account-operations" flowable:formKey="contract-signing"/>
        <sendTask id="sendNotifyCustomer" name="通知客户（审批通过即通知）"
                  flowable:delegateExpression="${customerNotifyDelegate}"/>
        <serviceTask id="svcOpenAccount" name="开户指令（核心系统，幂等键=申请编号+账户类型）"
                     flowable:async="true" flowable:delegateExpression="${accountOpenDelegate}">
            <extensionElements>
                <flowable:failedJobRetryTimeCycle>R3/PT10M</flowable:failedJobRetryTimeCycle>
            </extensionElements>
        </serviceTask>

        <!-- 等回执或超时，先到先走；超时时长配置化 -->
        <eventBasedGateway id="ebgwReceipt" name="等待开户回执/超时"/>
        <intermediateCatchEvent id="iccAccountResult" name="开户回执">
            <messageEventDefinition messageRef="msgAccountOpenResult"/>
        </intermediateCatchEvent>
        <intermediateCatchEvent id="iccReceiptTimeout" name="回执超时">
            <timerEventDefinition>
                <timeDuration>${accountReceiptTimeout}</timeDuration>
            </timerEventDefinition>
        </intermediateCatchEvent>

        <serviceTask id="svcArchive" name="归档（影像系统 + 业务库留档）"
                     flowable:async="true" flowable:delegateExpression="${accountArchiveDelegate}"/>
        <serviceTask id="svcReceiptAlert" name="回执超时告警（转人工）"
                     flowable:delegateExpression="${accountReceiptTimeoutDelegate}"/>
        <endEvent id="end"/>
        <endEvent id="endTimeoutHandled"/>

        <sequenceFlow id="flowStartContract" sourceRef="start" targetRef="utContract"/>
        <sequenceFlow id="flowContractNotify" sourceRef="utContract" targetRef="sendNotifyCustomer"/>
        <sequenceFlow id="flowNotifyOpen" sourceRef="sendNotifyCustomer" targetRef="svcOpenAccount"/>
        <sequenceFlow id="flowOpenEbgw" sourceRef="svcOpenAccount" targetRef="ebgwReceipt"/>
        <sequenceFlow id="flowEbgwResult" sourceRef="ebgwReceipt" targetRef="iccAccountResult"/>
        <sequenceFlow id="flowEbgwTimeout" sourceRef="ebgwReceipt" targetRef="iccReceiptTimeout"/>
        <sequenceFlow id="flowResultArchive" sourceRef="iccAccountResult" targetRef="svcArchive"/>
        <sequenceFlow id="flowArchiveEnd" sourceRef="svcArchive" targetRef="end"/>
        <sequenceFlow id="flowTimeoutAlert" sourceRef="iccReceiptTimeout" targetRef="svcReceiptAlert"/>
        <sequenceFlow id="flowAlertEnd" sourceRef="svcReceiptAlert" targetRef="endTimeoutHandled"/>

        <laneSet>
            <lane id="laneOperations" name="运营/开户岗">
                <flowNodeRef>utContract</flowNodeRef>
            </lane>
            <lane id="laneSystem" name="系统自动处理">
                <flowNodeRef>start</flowNodeRef>
                <flowNodeRef>sendNotifyCustomer</flowNodeRef>
                <flowNodeRef>svcOpenAccount</flowNodeRef>
                <flowNodeRef>ebgwReceipt</flowNodeRef>
                <flowNodeRef>iccAccountResult</flowNodeRef>
                <flowNodeRef>iccReceiptTimeout</flowNodeRef>
                <flowNodeRef>svcArchive</flowNodeRef>
                <flowNodeRef>svcReceiptAlert</flowNodeRef>
                <flowNodeRef>end</flowNodeRef>
                <flowNodeRef>endTimeoutHandled</flowNodeRef>
            </lane>
        </laneSet>
    </process>
</definitions>
