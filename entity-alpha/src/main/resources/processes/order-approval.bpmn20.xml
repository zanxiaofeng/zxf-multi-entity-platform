<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alpha 订单审批流程：风控检查 + 三级审批（文档 7.1/7.2）。
  流程拓扑差异外置为 BPMN，随 entity-alpha 模块经 Maven profile 裁剪进入 Alpha 产物，
  Beta 的流程定义不进入本镜像（与 5.4 同一机制），引擎启动自动部署（classpath*:/processes/）。

  processDefinitionKey 与 Beta 统一为 order-approval：内核按 key 发起实例，不关心拓扑；
  同 key 两份定义共存会静默错路由——装配冒烟断言"同 key 部署定义数 == 1"（文档 7.4）。
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://zxf.com/platform/order">

    <!-- 错误定义（BPMN 2.0 规范）：boundaryEvent 的 errorRef 指向此 id；
         引擎按 errorCode 与 BpmnError 匹配，缺定义虽可运行但属不规范建模 -->
    <error id="RISK_REJECTED" errorCode="RISK_REJECTED"/>

    <process id="order-approval" name="Alpha 订单三级审批">
        <startEvent id="start"/>
        <sequenceFlow id="flow-start-risk" sourceRef="start" targetRef="alphaRiskCheck"/>

        <!-- 实体专属任务：委托表达式引用 @ForEntity(EntityType.ALPHA) 限定的 Spring bean（文档 7.2 落地要点 3 / 5.10.1） -->
        <serviceTask id="alphaRiskCheck" name="Alpha 风控检查"
                     flowable:delegateExpression="${alphaRiskCheckDelegate}"/>
        <sequenceFlow id="flow-risk-l1" sourceRef="alphaRiskCheck" targetRef="alphaApproveL1"/>

        <!-- 错误分类示范（文档 7.7.1 组件 5）：alphaRiskCheck 抛 BpmnError(RISK_REJECTED)
             时由边界错误事件捕获，走"风控拒绝"分支——不触发 Job 重试（与 技术异常的
             failedJobRetryTimeCycle 重试路径对照）。cancelActivity 默认 true（取消原活动）。 -->
        <boundaryEvent id="riskCheckErrorBoundary" attachedToRef="alphaRiskCheck">
            <errorEventDefinition errorRef="RISK_REJECTED"/>
        </boundaryEvent>
        <sequenceFlow id="flow-error-reject" sourceRef="riskCheckErrorBoundary" targetRef="riskRejectedEnd"/>
        <endEvent id="riskRejectedEnd" name="风控拒绝"/>

        <userTask id="alphaApproveL1" name="Alpha 一级审批"/>
        <sequenceFlow id="flow-l1-l2" sourceRef="alphaApproveL1" targetRef="alphaApproveL2"/>

        <userTask id="alphaApproveL2" name="Alpha 二级审批"/>
        <sequenceFlow id="flow-l2-l3" sourceRef="alphaApproveL2" targetRef="alphaApproveL3"/>

        <userTask id="alphaApproveL3" name="Alpha 三级审批"/>
        <sequenceFlow id="flow-l3-notify" sourceRef="alphaApproveL3" targetRef="sendNotification"/>

        <!-- 通用任务：core 的共享 delegate。async 节点（通知类任务的典型形态）：
             由引擎 Job 执行器线程运行，delegate 基类从流程变量 entity 重建上下文（文档 7.3③）。
             failedJobRetryTimeCycle（文档 7.7.1 组件 4）：技术异常重试 3 次间隔 5 秒，
             耗尽进 ACT_RU_DEADLETTER_JOB 死信表——与 BpmnError 走分支不重试对照（组件 5） -->
        <serviceTask id="sendNotification" name="发送通知" flowable:async="true"
                     flowable:delegateExpression="${sendNotificationDelegate}">
            <extensionElements>
                <flowable:failedJobRetryTimeCycle>R3/PT5S</flowable:failedJobRetryTimeCycle>
            </extensionElements>
        </serviceTask>
        <sequenceFlow id="flow-notify-end" sourceRef="sendNotification" targetRef="end"/>

        <endEvent id="end"/>
    </process>
</definitions>
