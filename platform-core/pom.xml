<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zxf.platform</groupId>
        <artifactId>multi-entity-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-core</artifactId>
    <name>platform-core</name>
    <description>共享内核：抽象、上下文、横切能力（不允许分叉，差异代码只允许出现在扩展点实现里）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 指标支柱（文档 5.11.1）：Prometheus registry 与 actuator 同模块，
             配 MetricsConfig.entityCommonTags 给所有 meter 打 entity 标签 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- SB4 模块化拆包：MeterRegistryCustomizer 等自动配置类在独立模块
             spring-boot-micrometer-metrics（不在 actuator-autoconfigure） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics</artifactId>
        </dependency>
        <!-- Flowable 引擎属共享内核（文档 7.1）：运行时、持久化、与 Spring 事务/数据源整合，不允许分叉；
             流程拓扑（BPMN）在实体模块 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
        <!-- JSpecify 空安全：Boot 4 框架 API 全面采用，本骨架可空返回值同样标注（见文档 5.0） -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- ShedLock 定时任务选主（文档 7.7.2 组件 13）：多实例部署时保护 @Scheduled 防重。
             7.7.0 基于 Spring Framework 7.0.6 / SB 4.0.3 基线编译，与本项目 SB 4.1.x 兼容。
             shedlock-provider-jdbc-template 提供 JdbcTemplateLockProvider（基于 DataSource 的 JDBC 锁）。 -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>7.7.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>7.7.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 护栏（文档 7.2）：共享内核禁止依赖任何实体模块 -->
                                        <exclude>com.zxf.platform:entity-*</exclude>
                                    </excludes>
                                    <message>platform-core 不允许依赖实体模块，差异代码只能出现在扩展点实现里</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 生成 test-jar：发布测试支持类（如扩展点契约测试基类，文档 8.4）供实体模块继承。
                 Maven 默认 test 源集不打包；test-jar 让 platform-core 的测试基础设施可被
                 entity-alpha / entity-beta 以 <type>test-jar</type> 引用。
                 includes 只发布抽象契约基类（*ContractTest），不发布具体测试用例
                 （MoneyTest / OrderTest / ArchitectureGuardTest 等——它们是 platform-core
                 自测用的，与实体模块无关，发布出去是 classpath 噪音与发布面失控）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*ContractTest.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
