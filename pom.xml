<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.zxf.platform</groupId>
    <artifactId>multi-entity-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>multi-entity-platform</name>
    <description>单代码库多实体部署平台骨架（Spring Boot 4 / Spring Framework 7）</description>

    <modules>
        <module>platform-core</module>
        <module>entity-alpha</module>
        <module>entity-beta</module>
        <module>app</module>
    </modules>

    <properties>
        <!-- Spring Boot 4 基线 JDK 17，本骨架按文档建议用 21+（虚拟线程） -->
        <java.version>21</java.version>
        <archunit.version>1.4.2</archunit.version>
        <maven-enforcer-plugin.version>3.6.1</maven-enforcer-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.zxf.platform</groupId>
                <artifactId>platform-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxf.platform</groupId>
                <artifactId>entity-alpha</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zxf.platform</groupId>
                <artifactId>entity-beta</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>本骨架要求 JDK 21+（虚拟线程，见文档 5.0）</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
